<view class="container">
  <view class="header">
    <view class="icon-btn back-btn" bindtap="goBack">
      <text style="font-size:20px;">←</text>
    </view>
    <text class="title">药品列表</text>
    <view class="icon-btn" bindtap="goAdd">
      <text style="font-size:22px;color:#e8913a;">＋</text>
    </view>
  </view>

  <view class="search-filter-container">
    <view class="search-box">
      <text>🔍</text>
      <input type="text" placeholder="搜索药品名称..." bindinput="onSearchInput" value="{{searchTerm}}" />
    </view>
    <view class="filter-btn" bindtap="toggleFilter">
      <text>🔽</text>
    </view>
  </view>

  <view class="filter-options {{showFilter ? '' : 'hidden'}}" style="display:flex;gap:10px;margin-bottom:16px;">
    <view class="secondary-btn" style="flex:1;text-align:center;" bindtap="filterAll">全部</view>
    <view class="secondary-btn" style="flex:1;text-align:center;" bindtap="filterExpired">已过期</view>
    <view class="secondary-btn" style="flex:1;text-align:center;" bindtap="filterNearExpiry">即将过期</view>
    <view class="secondary-btn" style="flex:1;text-align:center;" bindtap="filterNormal">正常</view>
  </view>

  <view class="medicine-list">
    <view wx:if="{{filteredMedicines.length === 0}}" class="empty-text">暂无药品，请点击右上方按钮添加</view>
    <view wx:for="{{filteredMedicines}}" wx:key="index" class="medicine-item {{item.status}}" bindtap="goEdit" data-index="{{item.originalIndex}}">
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="detail">有效期：{{item.expiryDate}}</text>
        <text class="detail">位置：{{item.location}}</text>
        <text class="detail">数量：{{item.quantity}}</text>
      </view>
      <view class="danger-btn small" catchtap="deleteMedicine" data-index="{{item.originalIndex}}">删除</view>
    </view>
  </view>
</view>