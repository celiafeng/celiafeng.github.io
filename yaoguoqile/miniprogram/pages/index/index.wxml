<view class="container">
  <view class="header">
    <text class="title">小药过期了</text>
    <view class="icon-btn" bindtap="goSettings">
      <text style="font-size:22px;">⚙</text>
    </view>
  </view>

  <view class="sprite-container" style="right:{{spriteX}}px;bottom:{{spriteY}}px;" bindtap="onSpriteTap" catchtouchmove="onSpriteMove" catchtouchstart="onSpriteTouchStart">
    <view class="sprite-body {{spriteAction}}">
      <view class="plush-pill">
        <view class="pill-top"></view>
        <view class="pill-bottom"></view>
        <view class="leaf left-leaf"></view>
        <view class="leaf right-leaf"></view>
        <view class="leaf-stem"></view>
        <view class="eye left-eye">
          <view class="eye-shine"></view>
          <view class="eye-shine-small"></view>
        </view>
        <view class="eye right-eye">
          <view class="eye-shine"></view>
          <view class="eye-shine-small"></view>
        </view>
        <view class="blush left-blush"></view>
        <view class="blush right-blush"></view>
        <view class="mouth"></view>
        <view class="arm left-arm"></view>
        <view class="arm right-arm"></view>
        <view class="leg left-leg"></view>
        <view class="leg right-leg"></view>
      </view>
    </view>
    <view class="sprite-bubble {{bubbleShow ? 'show' : ''}}">{{bubbleText}}</view>
  </view>

  <view class="alert-card">
    <view class="alert-header">
      <text class="title">过期提醒</text>
      <text class="alert-badge">{{alertCount}}</text>
    </view>
    <view class="alert-content">
      <view wx:if="{{alertCount === 0}}" class="empty-text" style="margin-top:0;">暂无过期提醒</view>
      <view wx:for="{{expiredList}}" wx:key="index" class="expired-item {{item.type === 'expired' ? 'expired' : 'near-expiry'}}">
        <view class="info">
          <text class="name">{{item.name}}</text>
          <text class="detail">有效期：{{item.expiryDate}}</text>
          <text class="detail">位置：{{item.location}}</text>
        </view>
        <view wx:if="{{item.type === 'expired'}}" class="danger-btn small" catchtap="deleteFromAlert" data-index="{{item.originalIndex}}">删除</view>
      </view>
    </view>
  </view>

  <view class="function-grid">
    <view class="function-card" bindtap="goMedicines">
      <view class="function-icon">
        <text style="font-size:30px;">💊</text>
      </view>
      <text class="card-title">药品列表</text>
    </view>
    <view class="function-card add-card" bindtap="goAdd">
      <view class="function-icon">
        <text style="font-size:34px;color:white;">＋</text>
      </view>
    </view>
  </view>

  <view class="primary-btn" bindtap="shareToFamily" style="margin-top:20px;">分享亲人</view>
</view>