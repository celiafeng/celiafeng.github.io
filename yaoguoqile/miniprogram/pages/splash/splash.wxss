@import '../../styles/common.wxss';

/* ========== 主容器 ========== */
.main-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #fdf5ec 0%, #fff8e8 50%, #fff0d5 100%);
  position: relative;
  overflow: hidden;
}

/* ========== 顶部导航栏 ========== */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: rgba(255, 251, 245, 0.95);
  border-bottom: 1px solid #f0e0c8;
  position: relative;
  z-index: 10;
}

.nav-title {
  font-size: 18px;
  font-weight: 600;
  color: #8b4513;
}

/* ========== 页码指示器 ========== */
.page-indicator {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 10px 0;
  position: relative;
  z-index: 10;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #e0d0b8;
  transition: all 0.3s ease;
}

.dot.active {
  background-color: #e8913a;
  width: 24px;
  border-radius: 4px;
}

/* ========== 页面内容 ========== */
.page-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  opacity: 0;
  transform: translateX(40px);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.page-content.active {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

/* 离开动画 */
.page-content.leaving {
  opacity: 0;
  transform: translateX(-40px);
}

/* ========== 启动页 ========== */
.splash-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-inner {
  width: 100%;
  padding: 40px 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-circle {
  width: 100px;
  height: 100px;
  background: linear-gradient(135deg, #f0a050 0%, #e8913a 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(232, 145, 58, 0.4);
  animation: logoPulse 2s ease-in-out infinite;
  margin-bottom: 30px;
}

@keyframes logoPulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8px 24px rgba(232, 145, 58, 0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 12px 32px rgba(232, 145, 58, 0.5);
  }
}

.main-title {
  display: block;
  font-size: 36px;
  font-weight: 700;
  color: #8b4513;
  margin-bottom: 12px;
  letter-spacing: 4px;
}

.sub-title {
  display: block;
  font-size: 20px;
  font-weight: 500;
  color: #a06030;
  margin-bottom: 8px;
}

.desc {
  display: block;
  font-size: 14px;
  color: #8b7355;
}

.illustration {
  width: 100%;
  max-width: 320px;
  margin-bottom: 30px;
}

.illustration image {
  width: 100%;
  border-radius: 20px;
  box-shadow: 0 8px 24px rgba(180, 120, 60, 0.15);
}

.tap-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.8;
  margin-top: 10px;
}

.hint-text {
  font-size: 14px;
  color: #a0845c;
  margin-bottom: 12px;
}

.arrow-bounce {
  font-size: 24px;
  color: #e8913a;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10px);
  }
}

/* ========== 底部翻页提示 ========== */
.page-bottom-hint {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  padding: 8px 20px;
  background: rgba(232, 145, 58, 0.1);
  border-radius: 20px;
  z-index: 5;
}

.page-bottom-hint text {
  font-size: 13px;
  color: #e8913a;
  animation: fadeInOut 2s ease-in-out infinite;
}

@keyframes fadeInOut {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ========== 可滚动内容区域 ========== */
.dashboard-scroll,
.medicines-scroll,
.settings-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px 80px;
}

.form-container {
  padding: 16px 20px 80px;
  overflow-y: auto;
  flex: 1;
}

/* ========== 底部操作按钮 ========== */
.bottom-actions {
  padding: 16px 20px 70px;
}

/* ========== 背景装饰 ========== */
.main-container::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(240, 160, 80, 0.08) 0%, transparent 70%);
  pointer-events: none;
}

.main-container::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -30%;
  width: 80%;
  height: 80%;
  background: radial-gradient(circle, rgba(232, 145, 58, 0.06) 0%, transparent 60%);
  pointer-events: none;
}